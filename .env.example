# Avy's settings. You don't need this file: paste your key once in the page (the orange key
# button at the top right) and Avy writes .env for you. .env is in .gitignore, so it never goes
# to GitHub. If you'd rather write it by hand: copy this file to .env and fill in the key.

LUMINAL_API_KEY=

# Optional. These are the defaults.
# LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
# HELIX_FLASH_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# secrets: never commit
.env

# python
__pycache__/
*.pyc
.venv/

# everything Avy saves: settings, speech models, recordings
data/

# benchmark runs: keep the reports, not the throwaway memories or logs
tests/bench/results/*.memory/
tests/bench/results/*.log

# live test runs: keep the reports, not the throwaway memories or logs
tests/live/results/*.memory/
tests/live/results/*.log

# persona runs: keep the reports and the conversation (transcript.jsonl), not the throwaway memories and workspaces
tests/persona/results/*.memory/*
!tests/persona/results/*.memory/transcript.jsonl
tests/hands/results/*.work/
.playwright-mcp/
# Local benchmarking: the datasets are big, the outputs are bigger, and none of it belongs in a clone.
tests/locomo/data/
tests/locomo/out/
tests/bench/out/
tests/harness/out/
